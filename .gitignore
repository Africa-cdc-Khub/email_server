# Dependencies / build
/vendor
/node_modules
.npm-cache/
frontend/.npm-cache/
**/.npm-cache/

# Local env & secrets — NEVER commit these
.env
.env.*
!.env.example
!**/.env.example

docker/.env
backend/.env

# Exchange OAuth tokens (legacy plaintext file + any dumps)
**/exchange-oauth-tokens.json
**/exchange*token*.json
backend/storage/app/private/**
!backend/storage/app/private/.gitignore

# Reports / personal artifacts must not live in tests
backend/tests/**/*.docx
backend/tests/**/*.pdf
backend/tests/**/*Report*

# Production deploy secrets (copy outside the repo)
*.secrets.env
secrets.env
**/secrets.env
production.secrets.env
deploy/production.secrets.env
/etc-email-server/

# Laravel / runtime
backend/storage/logs/*
backend/storage/framework/cache/data/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# Frontend deps / build (never commit)
frontend/node_modules/
frontend/dist/
