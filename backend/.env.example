APP_NAME="Email Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089

# Swagger UI at /api/documentation (authenticated admin users only)
API_DOCS_ENABLED=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=email_server
DB_USERNAME=email_server
DB_PASSWORD=email_server

# Queue — Redis (required for async email dispatch)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONNECTION=queue
CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Bootstrap mailer only — Exchange/SMTP credentials are NOT stored in .env.
# Configure providers in the admin UI (encrypted in the database).
MAIL_MAILER=log

# Admin panel login (seeded)
ADMIN_EMAIL=andrewa@africacdc.org
ADMIN_PASSWORD=change-me-in-production
FRONTEND_URL=http://localhost:3006

# Simple word+number image CAPTCHA for Send email + provider test email
CAPTCHA_ENABLED=true
CAPTCHA_LENGTH=5
CAPTCHA_TTL=600

# JWT for external integration API (24h tokens)
INTEGRATION_CLIENT_SECRET=
JWT_SECRET=
JWT_TTL=60

# Optional attachment limits for POST /integrations/send and admin send-mail
MAIL_ATTACHMENT_MAX_COUNT=10
MAIL_ATTACHMENT_MAX_BYTES=5242880
MAIL_ATTACHMENT_MAX_TOTAL_BYTES=15728640

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8089,localhost:3006,127.0.0.1,127.0.0.1:8089,127.0.0.1:3006
